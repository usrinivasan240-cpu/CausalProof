# CausalProof Environment Variables
# Copy to .env.local for local development.

# Demo authentication (leave blank for demo mode — no auth required)
DEMO_USER=admin
DEMO_PASS_HASH=
DEMO_API_TOKEN=cp_demo_token_2026

# Data directory (default: <repo-root>/data)
# CAUSALPROOF_ROOT=C:/path/to/causalproof

# Optional LLM augmentation (not required for demo mode)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
